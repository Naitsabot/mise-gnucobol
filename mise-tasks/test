#!/usr/bin/env bash
#MISE description="Run plugin tests - install and execute GnuCOBOL"
set -euo pipefail

mise plugin link --force gnucobol .
mise cache clear
mise install gnucobol@3.2

# Capture and display the output while also verifying it
output=$(mise exec "gnucobol@3.2" -- "cobc" --version)
echo "cobc output: $output"

if echo "$output" | grep -q '3.2'; then
    echo "✓ Tests passed"
else
    echo "✗ Test failed: expected version gnucobol@3.2"
    exit 1
fi
